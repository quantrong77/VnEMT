{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vnemt.local/schema/case.schema.json",
  "title": "VnEMT case",
  "description": "VnEMT case file (SPEC-v0.1 section 9.1). Units are SI unless the key name says otherwise.",
  "type": "object",
  "required": [
    "case"
  ],
  "additionalProperties": false,
  "properties": {
    "case": {
      "type": "object",
      "required": [
        "name",
        "solver"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_\\-]+$"
        },
        "description": {
          "type": "string"
        },
        "solver": {
          "type": "object",
          "required": [
            "dt_us",
            "t_end_s"
          ],
          "additionalProperties": false,
          "properties": {
            "dt_us": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "t_end_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "method": {
              "enum": [
                "trapezoidal"
              ],
              "default": "trapezoidal"
            },
            "cda": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "init": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "zero",
                "loadflow",
                "snapshot"
              ],
              "default": "zero"
            },
            "file": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "snapshot"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "file"
            ]
          }
        },
        "snapshot": {
          "type": "object",
          "required": [
            "t_s",
            "file"
          ],
          "additionalProperties": false,
          "description": "Save a solver snapshot at t_s (path relative to the case file).",
          "properties": {
            "t_s": {
              "type": "number",
              "minimum": 0
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S_MVA": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "U_dc_kV": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "U_ac_kV": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "f_Hz": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "circuit": {
      "type": "object",
      "required": [
        "elements"
      ],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      }
    },
    "ac_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "U_kV",
          "scr",
          "angle_deg"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/sys_id"
          },
          "U_kV": {
            "$ref": "#/$defs/positive"
          },
          "f_Hz": {
            "$ref": "#/$defs/positive"
          },
          "scr": {
            "$ref": "#/$defs/positive"
          },
          "angle_deg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 90
          },
          "P_dc_MW": {
            "$ref": "#/$defs/positive"
          },
          "U_pu": {
            "$ref": "#/$defs/positive"
          },
          "phase_deg": {
            "type": "number"
          }
        }
      }
    },
    "converter_stations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "role",
          "ac_system",
          "transformer",
          "smoothing_reactor_H"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/sys_id"
          },
          "type": {
            "enum": [
              "lcc_6pulse",
              "lcc_12pulse"
            ]
          },
          "role": {
            "enum": [
              "rectifier",
              "inverter"
            ]
          },
          "ac_system": {
            "type": "string"
          },
          "pole": {
            "enum": [
              "positive",
              "negative"
            ]
          },
          "transformer": {
            "type": "object",
            "required": [
              "S_MVA",
              "U1_kV",
              "U2_kV",
              "xk_pu"
            ],
            "additionalProperties": false,
            "properties": {
              "S_MVA": {
                "$ref": "#/$defs/positive"
              },
              "U1_kV": {
                "$ref": "#/$defs/positive"
              },
              "U2_kV": {
                "$ref": "#/$defs/positive"
              },
              "xk_pu": {
                "$ref": "#/$defs/positive"
              },
              "tap": {
                "$ref": "#/$defs/positive"
              }
            }
          },
          "smoothing_reactor_H": {
            "$ref": "#/$defs/positive"
          },
          "valve": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "R_on_ohm": {
                "$ref": "#/$defs/positive"
              },
              "R_off_ohm": {
                "$ref": "#/$defs/positive"
              },
              "V_f_V": {
                "type": "number",
                "minimum": 0
              },
              "t_q_s": {
                "type": "number",
                "minimum": 0
              },
              "snubber": {
                "type": "object",
                "required": [
                  "R_ohm",
                  "C_F"
                ],
                "additionalProperties": false,
                "properties": {
                  "R_ohm": {
                    "$ref": "#/$defs/positive"
                  },
                  "C_F": {
                    "$ref": "#/$defs/positive"
                  }
                }
              }
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "Q_Mvar"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "capacitor",
                    "single_tuned",
                    "high_pass",
                    "double_tuned",
                    "c_type"
                  ]
                },
                "Q_Mvar": {
                  "$ref": "#/$defs/positive"
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 1
                },
                "q": {
                  "$ref": "#/$defs/positive"
                },
                "h2": {
                  "type": "number",
                  "exclusiveMinimum": 1
                },
                "switchable": {
                  "type": "boolean"
                },
                "closed": {
                  "type": "boolean"
                }
              }
            }
          },
          "control": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Id_ref_pu": {
                "type": "number"
              },
              "Id_start_pu": {
                "type": "number"
              },
              "ramp_start_s": {
                "type": "number"
              },
              "ramp_s": {
                "type": "number"
              },
              "alpha_min_deg": {
                "type": "number"
              },
              "alpha_max_deg": {
                "type": "number"
              },
              "alpha_start_deg": {
                "type": "number"
              },
              "kp_deg": {
                "type": "number"
              },
              "ki_deg": {
                "type": "number"
              },
              "T_id_s": {
                "type": "number"
              },
              "T_ud_up_s": {
                "type": "number"
              },
              "T_ud_down_s": {
                "type": "number"
              },
              "gamma_ref_deg": {
                "type": "number"
              },
              "margin_pu": {
                "type": "number"
              },
              "kp_gamma": {
                "type": "number"
              },
              "ki_gamma": {
                "type": "number"
              },
              "vdcol": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "u_low",
                      "u_high",
                      "i_low"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "u_low": {
                        "type": "number"
                      },
                      "u_high": {
                        "type": "number"
                      },
                      "i_low": {
                        "type": "number"
                      },
                      "i_high": {
                        "type": "number"
                      }
                    }
                  }
                ]
              },
              "gamma_cf_deg": {
                "type": "number"
              },
              "fr_u_det": {
                "type": "number"
              },
              "fr_t_det": {
                "type": "number"
              },
              "fr_vac_min": {
                "type": "number"
              },
              "fr_arm_ud": {
                "type": "number"
              },
              "fr_alpha_deg": {
                "type": "number"
              },
              "fr_t_deion": {
                "type": "number"
              },
              "cfprev_k_ab": {
                "type": "number"
              },
              "cfprev_k_0": {
                "type": "number"
              },
              "cfprev_u_th": {
                "type": "number"
              },
              "cfprev_max_deg": {
                "type": "number"
              },
              "cfprev_t_dec": {
                "type": "number"
              },
              "force_retard": {
                "type": "boolean"
              },
              "cfprev": {
                "type": "boolean"
              },
              "fr_n_restart": {
                "type": "integer",
                "minimum": 0
              },
              "fast_k": {
                "type": "number",
                "minimum": 1
              },
              "fast_e_pu": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "end": {
            "$ref": "#/$defs/sys_id"
          },
          "oltc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "step_pct": {
                "$ref": "#/$defs/positive"
              },
              "alpha_band_deg": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "ud_ref_pu": {
                "$ref": "#/$defs/positive"
              },
              "ud_band_pu": {
                "$ref": "#/$defs/positive"
              },
              "t_delay_s": {
                "type": "number",
                "minimum": 0
              },
              "t_min_s": {
                "type": "number",
                "minimum": 0
              },
              "t_enable_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "q_control": {
            "type": "object",
            "required": [
              "band_Mvar"
            ],
            "additionalProperties": false,
            "properties": {
              "band_Mvar": {
                "$ref": "#/$defs/positive"
              },
              "t_delay_s": {
                "type": "number",
                "minimum": 0
              },
              "t_lock_s": {
                "type": "number",
                "minimum": 0
              },
              "T_q_s": {
                "$ref": "#/$defs/positive"
              },
              "t_enable_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "dc_network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/sys_id"
              },
              "from": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              },
              "to": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                ]
              },
              "model": {
                "enum": [
                  "pi",
                  "t",
                  "bergeron"
                ]
              },
              "R_ohm": {
                "type": "number",
                "minimum": 0
              },
              "L_H": {
                "$ref": "#/$defs/positive"
              },
              "C_F": {
                "$ref": "#/$defs/positive"
              },
              "sections": {
                "type": "integer",
                "minimum": 1
              },
              "length_km": {
                "$ref": "#/$defs/positive"
              },
              "L_H_per_km": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1
                  }
                ]
              },
              "C_F_per_km": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1
                  }
                ]
              },
              "R_ohm_per_km": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "if": {
              "properties": {
                "model": {
                  "const": "bergeron"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "required": [
                "length_km",
                "L_H_per_km",
                "C_F_per_km"
              ]
            },
            "else": {
              "required": [
                "R_ohm",
                "L_H",
                "C_F"
              ]
            }
          }
        },
        "grounding": {
          "type": "object"
        },
        "electrodes": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "t_s"
        ],
        "properties": {
          "type": {
            "enum": [
              "ac_fault",
              "ac_dip",
              "dc_fault",
              "valve_short",
              "misfire",
              "setpoint"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ac_fault"
                }
              }
            },
            "then": {
              "required": [
                "location",
                "duration_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "location": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  ]
                },
                "kind": {
                  "enum": [
                    "3ph",
                    "1ph",
                    "2ph",
                    "2phg"
                  ]
                },
                "r_ohm": {
                  "type": "number",
                  "minimum": 0
                },
                "x_ohm": {
                  "type": "number",
                  "minimum": 0
                },
                "f_Hz": {
                  "$ref": "#/$defs/positive"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ac_dip"
                }
              }
            },
            "then": {
              "required": [
                "location",
                "depth_pct",
                "duration_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "depth_pct": {
                  "type": "number",
                  "minimum": -50,
                  "maximum": 100
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dc_fault"
                }
              }
            },
            "then": {
              "required": [
                "line",
                "duration_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "line": {
                  "type": "string"
                },
                "position": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "r_ohm": {
                  "type": "number",
                  "minimum": 0
                },
                "x_ohm": {
                  "type": "number",
                  "minimum": 0
                },
                "conductor": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "enum": [
                    "pole_ground",
                    "pole_pole"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "valve_short"
                }
              }
            },
            "then": {
              "required": [
                "valve",
                "duration_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "valve": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "misfire"
                }
              }
            },
            "then": {
              "required": [
                "valve"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "valve": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "setpoint"
                }
              }
            },
            "then": {
              "required": [
                "station",
                "param",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "t_s": {
                  "type": "number",
                  "minimum": 0
                },
                "type": true,
                "duration_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "note": {
                  "type": "string"
                },
                "station": {
                  "type": "string"
                },
                "param": {
                  "enum": [
                    "Id_ref_pu"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "ramp_s": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        ]
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recovery_90pct_ms": {
          "$ref": "#/$defs/positive"
        },
        "max_cf": {
          "type": "integer",
          "minimum": 0
        },
        "max_Id_pu": {
          "$ref": "#/$defs/positive"
        },
        "max_Ud_pu": {
          "$ref": "#/$defs/positive"
        },
        "min_Uac_pu": {
          "type": "number",
          "minimum": 0
        },
        "max_Uac_pu": {
          "$ref": "#/$defs/positive"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signals": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "format": {
          "type": "array",
          "items": {
            "enum": [
              "hdf5",
              "csv",
              "comtrade",
              "pscad_out",
              "mat"
            ]
          },
          "minItems": 1
        },
        "decimate": {
          "type": "integer",
          "minimum": 1
        },
        "dir": {
          "type": "string"
        }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      },
      "description": "Control blocks solved in order after the network each step (S-06)."
    }
  },
  "$defs": {
    "nodes2": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ramp": {
      "type": "number",
      "minimum": 0
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "nodes"
      ],
      "properties": {
        "type": {
          "enum": [
            "R",
            "L",
            "C",
            "V_dc",
            "V_ac",
            "I_dc",
            "I_ac",
            "SW",
            "D",
            "T",
            "XF1",
            "LINE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "R"
              }
            }
